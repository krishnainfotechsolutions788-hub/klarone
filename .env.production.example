# ==============================================================================
# 3. PRODUCTION CLOUD ENVIRONMENT (.env.production) - Used for 'main' branch
# ==============================================================================
# Configure these variables in:
#   - Render Web Service: klarone-api (Production)
#   - Vercel Environment Variables: Production
# ==============================================================================

# --- DATABASE (Live Production Database) ---
DATABASE_URL="postgresql://postgres.prod_id:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.prod_id:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- NETWORKING & PORTS (Production) ---
PORT=10000
NODE_ENV=production
NEXT_PUBLIC_API_BASE_URL="https://api.klarone.in"
WEB_ORIGINS="https://www.klarone.in,https://klarone.in"

# --- AUTHENTICATION & SECRETS ---
STAFF_AUTH_JWT_SECRET="prod-super-secure-random-staff-jwt-secret-key-32-chars-min"
STAFF_AUTH_JWT_EXPIRES_IN="12h"
STAFF_AUTH_JWT_ISSUER="klarone-api"
STAFF_AUTH_JWT_AUDIENCE="klarone-admin"

STAFF_BOOTSTRAP_EMAIL="admin@klarone.in"
STAFF_BOOTSTRAP_PASSWORD="admin@prodpassword"
STAFF_BOOTSTRAP_FIRST_NAME="Klarone"
STAFF_BOOTSTRAP_LAST_NAME="Admin"
STAFF_BOOTSTRAP_EMPLOYEE_CODE="KLN-ADM-001"

CUSTOMER_AUTH_JWT_SECRET="prod-super-secure-random-customer-jwt-secret-key-32-chars-min"
CUSTOMER_AUTH_JWT_EXPIRES_IN="30m"
CUSTOMER_AUTH_JWT_ISSUER="klarone-api"
CUSTOMER_AUTH_JWT_AUDIENCE="klarone-customer"

# Better Auth (Production Domain)
BETTER_AUTH_API_KEY="ba_production_key_here"
BETTER_AUTH_URL="https://api.klarone.in"
BETTER_AUTH_SECRET="prod-better-auth-secret-super-secure-key"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- THIRD PARTY SERVICES ---
RAZORPAY_KEY_ID="rzp_live_placeholder"
RAZORPAY_KEY_SECRET="razorpay_live_secret_placeholder"

GROQ_API_KEY="gsk_placeholder_groq_api_key"
GROQ_MODEL="openai/gpt-oss-120b"

CLOUDINARY_CLOUD_NAME="your-cloudinary-name"
CLOUDINARY_API_KEY="your-cloudinary-key"
CLOUDINARY_API_SECRET="your-cloudinary-secret"
STORAGE_PROVIDER="cloudinary"

RESEND_API_KEY="re_placeholder_resend_api_key"
RESEND_FROM_EMAIL="Klarone <admin@klarone.in>"
