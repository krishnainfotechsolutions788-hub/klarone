# --- DATABASE (Local PostgreSQL or Dev Cloud Instance) ---
DATABASE_URL="postgresql://postgres.dev_id:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.dev_id:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- NETWORKING & PORTS ---
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"
WEB_ORIGINS="http://localhost:3001,http://localhost:3000"

# --- AUTHENTICATION ---
STAFF_AUTH_JWT_SECRET="dev-staff-jwt-secret-local-only-replace"
STAFF_AUTH_JWT_EXPIRES_IN="12h"
STAFF_AUTH_JWT_ISSUER="klarone-api"
STAFF_AUTH_JWT_AUDIENCE="klarone-admin"

STAFF_BOOTSTRAP_EMAIL="admin@example.com"
STAFF_BOOTSTRAP_PASSWORD="admin@devpassword"
STAFF_BOOTSTRAP_FIRST_NAME="Klarone"
STAFF_BOOTSTRAP_LAST_NAME="Admin"
STAFF_BOOTSTRAP_EMPLOYEE_CODE="KLN-ADM-001"

CUSTOMER_AUTH_JWT_SECRET="dev-customer-jwt-secret-local-only-replace"
CUSTOMER_AUTH_JWT_EXPIRES_IN="30m"
CUSTOMER_AUTH_JWT_ISSUER="klarone-api"
CUSTOMER_AUTH_JWT_AUDIENCE="klarone-customer"

# Better Auth (Localhost)
BETTER_AUTH_API_KEY="ba_mock_key_for_development"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="klarone-better-auth-secret-super-secure-key"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- THIRD PARTY SERVICES ---
RAZORPAY_KEY_ID="rzp_test_placeholder"
